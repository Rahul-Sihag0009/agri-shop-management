generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockType {
  IN
  OUT
}

enum StockReason {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

enum PaymentMode {
  CASH
  UPI
  UNPAID
}

model Product {
  id Int @id @default(autoincrement())

  shopId Int

  productName String
  category    String
  company     String
  batchNumber String

  expiryDate DateTime

  purchasePrice Float
  sellingPrice  Float

  quantity Int

  unit String

  gst Float

  hsnCode String?

  minimumStock Int

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  stockHistory StockHistory[]

  saleItems SaleItem[]

  @@unique([shopId, batchNumber])
}

model StockHistory {
  id Int @id @default(autoincrement())

  productId Int

  type StockType

  reason StockReason

  quantity Int

  remarks String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id Int @id @default(autoincrement())

  shopId Int

  name String

  phone String

  address String?

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  sales Sale[]

  @@unique([shopId, phone])
}

model Sale {
  id Int @id @default(autoincrement())

  shopId Int

  invoiceNumber String

  invoiceSequence Int @default(0)

  customerId Int?

  paymentMode PaymentMode

  subtotal Float

  gst Float

  grandTotal Float

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customer Customer? @relation(fields: [customerId], references: [id])

  items SaleItem[]

  @@unique([shopId, invoiceNumber])
}

model SaleItem {
  id Int @id @default(autoincrement())

  saleId Int

  productId Int

  quantity Int

  price Float

  total Float

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])
}



model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF")

  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}



model Shop {
  id            Int      @id @default(autoincrement())

  shopName      String
  ownerName     String
  phone         String
  email         String
  address       String

  gstNumber     String?

  invoicePrefix String   @default("INV")
  currency      String   @default("₹")
  logo          String?

  products      Product[]
  customers     Customer[]
  users         User[]
  sales         Sale[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}